-- ANTI-AIM STEPPED LOGIC
---------------------------------------------------------
local spinAngle = 0
RunService.Stepped:Connect(function(_, deltaTime)
	if player.Character then
		local rootPart = player.Character:FindFirstChild("HumanoidRootPart")
		local hum = player.Character:FindFirstChildOfClass("Humanoid")
		
		if antiAimActive then
			if hum then hum.AutoRotate = false end
			if rootPart then
				spinAngle = (spinAngle + (currentSpinSpeed * 10 * deltaTime)) % (math.pi * 2)
				rootPart.CFrame = CFrame.new(rootPart.Position) * CFrame.Angles(0, spinAngle, 0)
			end
		elseif backwardAntiAimActive then
			if hum then hum.AutoRotate = false end
			if rootPart then
				local camLook = Camera.CFrame.LookVector
				local yaw = math.atan2(-camLook.X, -camLook.Z)
				rootPart.CFrame = CFrame.new(rootPart.Position) * CFrame.Angles(0, yaw + math.pi, 0)
			end
		end
	end
end)

---------------------------------------------------------
-- RENDER LOOP (Invis Weapon + Viewmodel Arms in Camera + Caching)
---------------------------------------------------------
RunService.RenderStepped:Connect(function(deltaTime)
	hue = (hue + (deltaTime * 0.5)) % 1
	local rainbowColor = Color3.fromHSV(hue, 1, 1)

	if borderRainbowMode then
		uiStroke.Color = rainbowColor
		miniStroke.Color = rainbowColor
	end

	if buttonRainbowMode then
		activeTabBg = rainbowColor
		switchTab(currentActiveTab)
		saveConfigBtn.BackgroundColor3 = rainbowColor
		loadConfigBtn.BackgroundColor3 = rainbowColor
		camoPaletteToggleBtn.BackgroundColor3 = paletteOpen and rainbowColor or Color3.fromRGB(40, 32, 52)
	else
		saveConfigBtn.BackgroundColor3 = activeTabBg
		loadConfigBtn.BackgroundColor3 = activeTabBg
		camoPaletteToggleBtn.BackgroundColor3 = paletteOpen and activeTabBg or Color3.fromRGB(40, 32, 52)
	end

	if crosshairActive and crosshairFrame.Visible then
		crosshairFrame.Rotation = (crosshairFrame.Rotation + (currentRotSpeed * 100 * deltaTime)) % 360
		vBar.BackgroundColor3 = rainbowColor
		hBar.BackgroundColor3 = rainbowColor
		crosshairTextLabel.TextColor3 = rainbowColor
	end

	title.TextColor3 = rainbowColor

	local shouldHide = invisibleWeaponActive or thirdPersonStyleActive or thirdPersonActive

	-- 1. Handle Camera Viewmodels & Client First-Person Arms/Weapons
	for _, desc in ipairs(Camera:GetDescendants()) do
		if desc:IsA("BasePart") then
			local nameLower = desc.Name:lower()
			if nameLower:find("arm") or nameLower:find("hand") or nameLower:find("viewmodel") or nameLower:find("weapon") or nameLower:find("gun") or nameLower:find("blade") or nameLower:find("left") or nameLower:find("right") then
				if not originalPartData[desc] then
					originalPartData[desc] = {
						Transparency = desc.Transparency,
						LocalTransparencyModifier = desc.LocalTransparencyModifier,
						Material = desc.Material,
						Color = desc.Color
					}
				end
				if shouldHide then
					desc.Transparency = 1
					desc.LocalTransparencyModifier = 1
				else
					local orig = originalPartData[desc]
					if orig then
						desc.Transparency = orig.Transparency
						desc.LocalTransparencyModifier = orig.LocalTransparencyModifier
					end
				end
			end
		end
	end

	if player.Character then
		local char = player.Character
		
		-- 2. Handle Character Arms & Hands (R6 & R15 supported) with secure caching
		local armNames = {"Right Arm", "Left Arm", "RightArm", "LeftArm", "Right Upper Arm", "Right Lower Arm", "RightHand", "Left Upper Arm", "Left Lower Arm", "LeftHand"}
		for _, name in ipairs(armNames) do
			local part = char:FindFirstChild(name)
			if part and part:IsA("BasePart") then
				if not originalPartData[part] then
					originalPartData[part] = {
						Transparency = part.Transparency,
						LocalTransparencyModifier = part.LocalTransparencyModifier,
						Material = part.Material,
						Color = part.Color
					}
				end
				
				if shouldHide then
					part.Transparency = 1
					part.LocalTransparencyModifier = 1
				else
					local orig = originalPartData[part]
					if orig then
						part.Transparency = orig.Transparency
						part.LocalTransparencyModifier = orig.LocalTransparencyModifier
					end
				end
			end
		end

		local tool = char:FindFirstChildOfClass("Tool")
		if tool then
			local selectedOpt = colorOptions[selectedColorIndex]
			local chosenColor = Color3.fromRGB(255, 255, 255)
			
			if selectedOpt.Type == "Solid" then
				chosenColor = selectedOpt.Color
			elseif selectedOpt.Type == "Gradient" then
				local gIndex = (math.floor(hue * #selectedOpt.Colors) % #selectedOpt.Colors) + 1
				local nextIndex = (gIndex % #selectedOpt.Colors) + 1
				local alpha = (hue * #selectedOpt.Colors) % 1
				chosenColor = selectedOpt.Colors[gIndex]:Lerp(selectedOpt.Colors[nextIndex], alpha)
			end

			local hl = tool:FindFirstChild("WeaponHighlight")
			if weaponCamoActive and not shouldHide then
				if not hl then
					hl = Instance.new("Highlight")
					hl.Name = "WeaponHighlight"
					hl.Parent = tool
				end
				hl.FillColor = chosenColor
				hl.OutlineColor = Color3.fromRGB(255, 255, 255)
			elseif hl then
				hl:Destroy()
			end

			for _, part in ipairs(tool:GetDescendants()) do
				if part:IsA("BasePart") then
					if not originalPartData[part] then
						originalPartData[part] = {
							Transparency = part.Transparency,
							LocalTransparencyModifier = part.LocalTransparencyModifier,
							Material = part.Material,
							Color = part.Color,
							Reflectance = part.Reflectance
						}
					end

					local pName = part.Name:lower()
					if pName:find("scope") or pName:find("sight") or pName:find("visier") then
						part.Transparency = 1
						part.LocalTransparencyModifier = 1
						part.CanCollide = false
					else
						local orig = originalPartData[part]
						
						if shouldHide then
							part.Transparency = 1
							part.LocalTransparencyModifier = 1
						else
							if orig then
								part.Transparency = orig.Transparency
								part.LocalTransparencyModifier = orig.LocalTransparencyModifier
							end
						end

						if weaponCamoActive and not shouldHide then
							part.Color = chosenColor
							part.Material = Enum.Material.Neon
							part.Reflectance = 0.5
						else
							if orig then
								part.Color = orig.Color
								part.Material = orig.Material
								part.Reflectance = orig.Reflectance or 0
							end
						end
					end
				end
			end
		end
	end
end)

