UserInputService.InputChanged:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
		local function getRelativeX(track) return math.clamp((input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1) end
		if slidingSpeed then currentSpeedValue = math.floor(minSpeed + (getRelativeX(speedTrack) * (maxSpeed - minSpeed))) updateGUIFromValues()
		elseif slidingJump then currentJumpValue = math.floor(minJump + (getRelativeX(jumpTrack) * (maxJump - minJump))) updateGUIFromValues()
		elseif slidingSpin then currentSpinSpeed = math.floor(minSpin + (getRelativeX(spinTrack) * (maxSpin - minSpin))) updateGUIFromValues()
		elseif slidingRot then currentRotSpeed = math.floor(minRot + (getRelativeX(rotTrack) * (maxRot - minRot))) updateGUIFromValues()
		elseif slidingThick then currentThickness = math.floor(minThick + (getRelativeX(thickTrack) * (maxThick - minThick))) updateGUIFromValues()
		elseif slidingSize then currentSizeValue = math.floor(minSize + (getRelativeX(sizeTrack) * (maxSize - minSize))) updateGUIFromValues()
		elseif slidingEspDist then currentEspDist = math.floor(minEspDist + (getRelativeX(espDistTrack) * (maxEspDist - minEspDist))) updateGUIFromValues()
		elseif draggingCrosshair and freeCrosshairActive then
			local mousePos = UserInputService:GetMouseLocation()
			local vpSize = Camera.ViewportSize
			customPosX = math.clamp(mousePos.X / vpSize.X, 0, 1)
			customPosY = math.clamp(mousePos.Y / vpSize.Y, 0, 1)
			crosshairFrame.Position = UDim2.new(customPosX, 0, customPosY, 0)
		end
	end
end)

