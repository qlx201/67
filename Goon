local function createTabBtn(name, text, posScale, sizeWidth)
	local btn = Instance.new("TextButton")
	btn.Name = name
	btn.Size = UDim2.new(sizeWidth or 0.16, 0, 1, 0)
	btn.Position = UDim2.new(posScale, 0, 0, 0)
	btn.BackgroundColor3 = Color3.fromRGB(30, 24, 40)
	btn.TextColor3 = Color3.fromRGB(200, 200, 215)
	btn.Text = text
	btn.TextSize = 10
	btn.Font = Enum.Font.GothamBold
	btn.Parent = tabNavFrame
	
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, 6)
	c.Parent = btn
	return btn
end

