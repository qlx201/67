			customAtmosphere.Glare = 0.6
			customAtmosphere.Haze = 0.15
			customAtmosphere.Parent = Lighting
		end
	else
		Lighting.ClockTime = 14
		Lighting.Brightness = 2
		Lighting.Ambient = Color3.fromRGB(128, 128, 128)
		Lighting.OutdoorAmbient = Color3.fromRGB(128, 128, 128)
		
		local s = Lighting:FindFirstChild("CustomNightSky")
		if s then s:Destroy() end
		local a = Lighting:FindFirstChild("CustomNightAtmosphere")
		if a then a:Destroy() end
	end
end

local function getHumanoid()
	local char = player.Character
	if char then
		return char:FindFirstChildOfClass("Humanoid")
	end
	return nil
end

local function applyStats()
	local hum = getHumanoid()
	local activeSpeed = math.max(0, currentSpeedValue + speedOffsetState)
	local activeJump = math.max(0, currentJumpValue)

	if hum then
		hum.WalkSpeed = activeSpeed
		hum.UseJumpPower = true
		hum.JumpPower = activeJump
		hum.JumpHeight = (activeJump / 50) * 7.2
		
		if antiAimActive or backwardAntiAimActive then
			hum.AutoRotate = false
		else
			hum.AutoRotate = true
		end
	end

	if thirdPersonActive then
		player.CameraMode = Enum.CameraMode.Classic
		player.CameraMinZoomDistance = 10
		player.CameraMaxZoomDistance = 20
	else
		player.CameraMinZoomDistance = 0.5
		player.CameraMaxZoomDistance = 0.5
		player.CameraMode = Enum.CameraMode.LockFirstPerson
	end
	
	applyNightMode()
end

