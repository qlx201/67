local function saveConfig()
	local data = {
		WalkSpeed = currentSpeedValue,
		JumpPower = currentJumpValue,
		SpinSpeed = currentSpinSpeed,
		RotSpeed = currentRotSpeed,
		Thickness = currentThickness,
		CrossSize = currentSizeValue,
		EspDistance = currentEspDist,
		CrosshairOn = crosshairActive,
		FreeCrosshairOn = freeCrosshairActive,
		AntiAimOn = antiAimActive,
		BackwardAntiAimOn = backwardAntiAimActive,
		ThirdPersonOn = thirdPersonActive,
		WeaponCamoOn = weaponCamoActive,
		NameTagsOn = nameTagsActive,
		InvisibleWeaponOn = invisibleWeaponActive,
		NightModeOn = nightModeActive,
		DoubleJumpOn = doubleJumpActive,
		CamoIndex = selectedColorIndex,
		CrossStyle = crosshairStyle,
		PosX = customPosX,
		PosY = customPosY,
		BorderRainbow = borderRainbowMode,
		ButtonRainbow = buttonRainbowMode,
		ActiveBgR = activeTabBg.R,
		ActiveBgG = activeTabBg.G,
		ActiveBgB = activeTabBg.B
	}
	if writefile then
		pcall(function()
			writefile(configFileName, HttpService:JSONEncode(data))
		end)
		statusLabel.Text = "Config Saved!"
		task.delay(1.5, function() statusLabel.Text = "Loop: Auto-Active" end)
	end
end

local function loadConfig()
	if readfile and isfile and isfile(configFileName) then
		local success, result = pcall(function()
			return HttpService:JSONDecode(readfile(configFileName))
		end)
		if success and result then
			currentSpeedValue = result.WalkSpeed or 16
			currentJumpValue = result.JumpPower or 50
			currentSpinSpeed = result.SpinSpeed or 50
			currentRotSpeed = result.RotSpeed or 2
			currentThickness = result.Thickness or 2
			currentSizeValue = result.CrossSize or 40
			currentEspDist = result.EspDistance or 1000
			
			if result.CrosshairOn ~= nil then crosshairActive = result.CrosshairOn end
			if result.FreeCrosshairOn ~= nil then 
				freeCrosshairActive = result.FreeCrosshairOn
				crosshairOutline.Enabled = freeCrosshairActive
				freeCrosshairBtn.Text = freeCrosshairActive and "Free Crosshair: ON" or "Free Crosshair: OFF"
			end
			
			antiAimActive = result.AntiAimOn or false
			backwardAntiAimActive = result.BackwardAntiAimOn or false
			thirdPersonActive = result.ThirdPersonOn or false
			weaponCamoActive = result.WeaponCamoOn or false
			nameTagsActive = result.NameTagsOn or false
			invisibleWeaponActive = result.InvisibleWeaponOn or false
			nightModeActive = result.NightModeOn or false
			doubleJumpActive = result.DoubleJumpOn or false
			selectedColorIndex = result.CamoIndex or 1
			crosshairStyle = result.CrossStyle or "Standard"
			
			if result.PosX and result.PosY then
				customPosX = result.PosX
				customPosY = result.PosY
			end
			
			if result.BorderRainbow ~= nil then borderRainbowMode = result.BorderRainbow end
			if result.ButtonRainbow ~= nil then buttonRainbowMode = result.ButtonRainbow end
			if result.ActiveBgR and result.ActiveBgG and result.ActiveBgB then
				activeTabBg = Color3.new(result.ActiveBgR, result.ActiveBgG, result.ActiveBgB)
			end

			updateGUIFromValues()
			statusLabel.Text = "Config Loaded!"
			task.delay(1.5, function() statusLabel.Text = "Loop: Auto-Active" end)
		end
	end
end

