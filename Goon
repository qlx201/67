local function createTabPage(name, isScrollable)
	if isScrollable then
		local scroll = Instance.new("ScrollingFrame")
		scroll.Name = name
		scroll.Size = UDim2.new(1, 0, 0, 225)
		scroll.Position = UDim2.new(0, 0, 0, 70)
		scroll.BackgroundTransparency = 1
		scroll.BorderSizePixel = 0
		scroll.ScrollBarThickness = 4
		scroll.ScrollBarImageColor3 = Color3.fromRGB(120, 90, 150)
		scroll.CanvasSize = UDim2.new(0, 0, 0, 260)
		scroll.Visible = false
		scroll.Parent = frame
		return scroll
	else
		local page = Instance.new("Frame")
		page.Name = name
		page.Size = UDim2.new(1, 0, 0, 225)
		page.Position = UDim2.new(0, 0, 0, 70)
		page.BackgroundTransparency = 1
		page.Visible = false
		page.Parent = frame
		return page
	end
end

