-- NAME ESP LOOP
RunService.RenderStepped:Connect(function()
	local myChar = player.Character
	local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
	
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= player and p.Character then
			local char = p.Character
			local head = char:FindFirstChild("Head")
			local targetRoot = char:FindFirstChild("HumanoidRootPart")
			
			if head then
				local tag = head:FindFirstChild("CustomNameTag")
				local inRange = false
				
				if myRoot and targetRoot then
					local dist = (myRoot.Position - targetRoot.Position).Magnitude
					if dist <= currentEspDist then inRange = true end
				end

				if nameTagsActive and inRange then
					if not tag then
						tag = Instance.new("BillboardGui")
						tag.Name = "CustomNameTag"
						tag.Size = UDim2.new(0, 100, 0, 24)
						tag.StudsOffset = Vector3.new(0, 2.2, 0)
						tag.AlwaysOnTop = true
						tag.Parent = head

						local txt = Instance.new("TextLabel")
						txt.Name = "NameText"
						txt.Size = UDim2.new(1, 0, 1, 0)
						txt.BackgroundTransparency = 1
						txt.TextColor3 = Color3.fromRGB(255, 255, 255)
						txt.TextStrokeTransparency = 0.5
						txt.TextSize = 9
						txt.Font = Enum.Font.GothamBold
						txt.Parent = tag
					end
					local txt = tag:FindFirstChild("NameText")
					if txt then txt.Text = p.Name end
					tag.Enabled = true
				elseif tag then
					tag.Enabled = false
				end
			end
		end
	end
end)

