	local tabs = {tab1Btn, tab2Btn, tab3Btn, tab4Btn, tab5Btn, tab6Btn}
	for i, btn in ipairs(tabs) do
		if i == tabNum then
			btn.BackgroundColor3 = buttonRainbowMode and Color3.fromHSV(hue, 1, 1) or activeTabBg
