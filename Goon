function switchTab(tabNum)
	currentActiveTab = tabNum
	tab1Page.Visible = (tabNum == 1)
	tab2Page.Visible = (tabNum == 2)
	tab3Page.Visible = (tabNum == 3)
	tab4Page.Visible = (tabNum == 4)
