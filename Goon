local function createSlider(parent, name, labelText, yPos)
	local label = Instance.new("TextLabel")
	label.Name = name .. "Label"
	label.Size = UDim2.new(1, -20, 0, 16)
	label.Position = UDim2.new(0, 12, 0, yPos)
	label.BackgroundTransparency = 1
	label.Text = labelText
	label.TextColor3 = Color3.fromRGB(200, 200, 215)
	label.TextSize = 12
	label.Font = Enum.Font.Gotham
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.Parent = parent

	local track = Instance.new("Frame")
	track.Name = name .. "Track"
	track.Size = UDim2.new(0.94, 0, 0, 6)
	track.Position = UDim2.new(0.03, 0, 0, yPos + 18)
	track.BackgroundColor3 = Color3.fromRGB(32, 25, 42)
	track.BackgroundTransparency = 0.3
	track.BorderSizePixel = 0
	track.Parent = parent

	local trackCorner = Instance.new("UICorner")
	trackCorner.CornerRadius = UDim.new(1, 0)
	trackCorner.Parent = track

	local fill = Instance.new("Frame")
	fill.Name = name .. "Fill"
	fill.Size = UDim2.new(0.2, 0, 1, 0)
	fill.BackgroundColor3 = Color3.fromRGB(140, 140, 180)
	fill.BorderSizePixel = 0
	fill.Parent = track

	local fillCorner = Instance.new("UICorner")
	fillCorner.CornerRadius = UDim.new(1, 0)
	fillCorner.Parent = fill

	local btn = Instance.new("TextButton")
	btn.Name = name .. "Button"
	btn.Size = UDim2.new(0, 16, 0, 16)
	btn.Position = UDim2.new(1, -8, 0.5, -8)
	btn.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	btn.Text = ""
	btn.Parent = fill

	local btnCorner = Instance.new("UICorner")
	btnCorner.CornerRadius = UDim.new(1, 0)
	btnCorner.Parent = btn

	return label, track, fill, btn
end

