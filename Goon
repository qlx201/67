serverHopBtn.MouseButton1Click:Connect(function()
	statusLabel.Text = "Searching new server..."
	task.spawn(function()
		pcall(function()
			local servers = {}
			local cursor = ""
			repeat
				local url = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"
				if cursor ~= "" then url = url .. "&cursor=" .. cursor end
				local successHttp, response = pcall(function() return game:HttpGet(url) end)
				if not successHttp or not response then break end
				local data = HttpService:JSONDecode(response)
				cursor = data.nextPageCursor or ""
				if data and data.data then
					for _, s in ipairs(data.data) do
						if type(s) == "table" and s.playing and s.maxPlayers and s.id then
							if s.playing < s.maxPlayers and s.id ~= game.JobId then
								table.insert(servers, s.id)
							end
						end
					end
				end
			until cursor == "" or #servers > 0 or cursor == nil

			if #servers > 0 then
				TeleportService:TeleportToPlaceInstance(game.PlaceId, servers[math.random(1, #servers)], player)
			else
				TeleportService:Teleport(game.PlaceId, player)
			end
		end)
	end)
end)

